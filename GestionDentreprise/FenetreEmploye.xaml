<Window x:Class="GestionDentreprise.FenetreEmploye"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionDentreprise"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Tableau de bord employé"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Icon="/images/icone-gestion.ico"

        Style="{StaticResource MaterialDesignWindow}">

    <DockPanel>
        <StackPanel DockPanel.Dock="Left" Width="220" Background="#FF421E7B" Cursor="Hand">
                            <materialDesign:ColorZone VerticalAlignment="Stretch" Mode="PrimaryLight" Background="#FF421E7B">
                            <materialDesign:PackIcon Width="128" Height="128" HorizontalAlignment="Center" VerticalAlignment="Center" Kind="AccountCircle"/>
                        </materialDesign:ColorZone>

                       





            <StackPanel VerticalAlignment="Bottom" Margin="10"/>
            <Button Content="Informations personnelles" Style="{StaticResource MaterialDesignFlatDarkBgButton}" Margin="10" Click="Button_Click" BorderBrush="#FF250F54"/>
            <Button

Content="Deconnexion"
IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}"
Style="{StaticResource MaterialDesignOutlinedButton}"
ToolTip="MaterialDesignOutlinedButton" BorderBrush="#FFE7DFF6" Foreground="#FFDFD3F3" Height="38" Margin="0,491,0,0" Click="Button_Click_1"
/>
        </StackPanel>

        <DockPanel AllowDrop="True" x:Name="DkPanel" Cursor="Hand">
            <Grid DockPanel.Dock="Top" Height="60" Background="{DynamicResource PrimaryHueLightBrush}">
                <TextBlock Text="Tableau de bord employé" VerticalAlignment="Center" Margin="20,0,0,0"
                           FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
            </Grid>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <materialDesign:Card Margin="10" Padding="10" Width="200" Height="100">
                        <StackPanel>
                            <TextBlock Text="Projets en cours" FontWeight="Bold"/>
                            <TextBlock FontSize="24" x:Name="nbEncours"/>
                        </StackPanel>
                    </materialDesign:Card>
                    <materialDesign:Card Margin="10" Padding="10" Width="200" Height="100">
                        <StackPanel>
                            <TextBlock Text="Projets terminés" FontWeight="Bold"/>
                            <TextBlock FontSize="24" x:Name="nbFini"/>
                        </StackPanel>
                    </materialDesign:Card>
                    <materialDesign:Card Margin="10" Padding="10" Width="200" Height="100">
                        <StackPanel>
                            <TextBlock Text="Tâches à faire" FontWeight="Bold"/>
                            <TextBlock FontSize="24" x:Name="nbAFaire"/>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Margin="10" Padding="10" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="À faire" FontWeight="Bold" FontSize="16"/>
                            <ListView x:Name="TodoList"
                                      AllowDrop="True"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      MinHeight="300"
                                      PreviewMouseMove="ListView_PreviewMouseMove"
                                      Drop="ListView_Drop">
                            </ListView>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" Margin="10" Padding="10" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="En cours" FontWeight="Bold" FontSize="16"/>
                            <ListView x:Name="DoingList"
                                      AllowDrop="True"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      MinHeight="300"
                                      PreviewMouseMove="ListView_PreviewMouseMove"
                                      Drop="ListView_Drop">
                            </ListView>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="2" Margin="10" Padding="10" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="Terminé" FontWeight="Bold" FontSize="16"/>
                            <ListView x:Name="DoneList"
                                      AllowDrop="True"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      MinHeight="300"
                                      PreviewMouseMove="ListView_PreviewMouseMove"
                                      Drop="ListView_Drop">
                            </ListView>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
