<Window x:Class="GestionDentreprise.AfficherTache"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Icon="/images/icone-gestion.ico"
        Title="Afficher Tâche" Height="500" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF5F5F5">

    <Grid Margin="10">
        <Border CornerRadius="8" Background="White" BorderBrush="#FF421E7B" BorderThickness="2" Padding="15">
            <materialDesign:Card Padding="8" Background="White">
                <StackPanel>

                    <TextBlock Text="Titre" FontSize="18" FontWeight="Bold" Foreground="#FF421E7B" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtTitre" IsReadOnly="True" FontSize="14" Margin="0,0,0,8"/>

                    <TextBlock Text="Description" FontWeight="SemiBold" Foreground="#FF421E7B" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtDescription" IsReadOnly="True" TextWrapping="Wrap" Height="60" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Priorité: " FontWeight="SemiBold" Foreground="#FF421E7B"/>
                        <TextBox x:Name="txtPriorite" IsReadOnly="True" Width="80"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Date création: " FontWeight="SemiBold" Foreground="#FF421E7B"/>
                        <TextBox x:Name="txtDateCreation" IsReadOnly="True" Width="100"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Date limite: " FontWeight="SemiBold" Foreground="#FF421E7B"/>
                        <TextBox x:Name="txtDateLimite" IsReadOnly="True" Width="100"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="État: " FontWeight="SemiBold" Foreground="#FF421E7B"/>
                        <TextBox x:Name="txtEtat" IsReadOnly="True" Width="100"/>
                    </StackPanel>

                
                    <Button Content="OK" Width="90" Height="30" HorizontalAlignment="Center"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="Button_OK_Click"/>
                </StackPanel>
            </materialDesign:Card>
        </Border>
    </Grid>
</Window>
