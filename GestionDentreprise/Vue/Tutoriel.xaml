<Window x:Class="GestionDentreprise.Vue.Tutoriel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Tutoriel" Height="550" Width="800"
        WindowStartupLocation="CenterScreen"
        Icon="/Vue/images/icone-gestion.ico"
        materialDesign:ColorZoneAssist.Mode="PrimaryDark">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border CornerRadius="8" BorderBrush="#FF6200EE" BorderThickness="2" Margin="0,0,0,10">
            <MediaElement x:Name="VideoPlayer"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Stretch="Uniform"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1" Margin="0,10,0,0">
            <Button x:Name="BtnRetour" Content="-10s" Width="90" Height="40" Margin="5" 
                    FontSize="14" Click="BtnRetour_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
            <Button x:Name="BtnPlay" Content="Jouer" Width="90" Height="40" Margin="5" 
                    FontSize="16" Click="BtnPlay_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
            <Button x:Name="BtnPause" Content="Pause" Width="90" Height="40" Margin="5" 
                    FontSize="16" Click="BtnPause_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
            <Button x:Name="BtnStop" Content="Stop" Width="90" Height="40" Margin="5" 
                    FontSize="16" Click="BtnStop_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
            <Button x:Name="BtnAvance" Content="+10s" Width="90" Height="40" Margin="5" 
                    FontSize="14" Click="BtnAvance_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>
    </Grid>
</Window>
