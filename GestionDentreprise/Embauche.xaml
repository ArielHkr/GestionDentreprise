<Window x:Class="GestionDentreprise.Embauche"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Embaucher un employé"
        Height="400" Width="450"
        Icon="/images/icone-gestion.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Nom :" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="txtNom" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Prénom :" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="txtPrenom" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Courriel :" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="txtEmail" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Mot de passe :" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
        <PasswordBox x:Name="txtMotDePasse" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Confirmer mot de passe :" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
        <PasswordBox x:Name="txtConfirmation" Grid.Row="4" Grid.Column="1" Margin="5"/>

        <TextBlock x:Name="lblMessage" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                   Foreground="Red" TextAlignment="Center" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Embaucher" Width="120" Margin="10" Click="BtnEmbaucher_Click"/>
            <Button Content="Annuler" Width="120" Margin="10" Click="BtnAnnuler_Click"/>
        </StackPanel>
    </Grid>
</Window>
