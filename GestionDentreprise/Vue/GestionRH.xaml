<Window x:Class="GestionDentreprise.GestionRH"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion RH"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="/Vue/images/icone-gestion.ico">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Rechercher un employé" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtRecherche" Width="250" ToolTip="Rechercher un employé"/>
                <Button x:Name="btnRecherche" Content="Rechercher" Width="132" Margin="5,0,0,0" Click="RechercherEmploye_Click"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Gestion des employés" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Liste des employés"/>
                    <ComboBox x:Name="cbEmployes" Width="200" Margin="0,5,0,10" ToolTip="Liste des employés" SelectionChanged="cbEmployes_SelectionChanged"/>
                    <StackPanel>
                        <TextBlock Text="Nom" IsEnabled="False" Margin="0,3,0,0"/>
                        <TextBox x:Name="txtNom" IsEnabled="False" Margin="0,0,0,3"/>
                        <TextBlock Text="Prénom" IsEnabled="False" Margin="0,3,0,0"/>
                        <TextBox x:Name="txtPrenom" IsEnabled="False" Margin="0,0,0,3"/>
                        <TextBlock Text="Email" IsEnabled="False" Margin="0,3,0,0"/>
                        <TextBox x:Name="txtEmail" IsEnabled="False" Margin="0,0,0,3"/>
                        <TextBlock Text="Date d'embauche" IsEnabled="False" Margin="0,3,0,0"/>
                        <DatePicker x:Name="dpEmbauche" IsEnabled="False" Margin="0,0,0,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,0">
                        <Button Content="Ajouter" Width="114" Margin="0,0,5,0" Click="Button_Click_1"/>
                        <Button Content="Désactiver" Width="133" Click="Button_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,0,0">
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Tâches de l’employé" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                        <ListBox x:Name="lstTaches" MinHeight="150" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto" Width="352"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Employé recherché" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                        <ListBox x:Name="lstEmployeRecherche" MinHeight="150" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="lstEmployeRecherche_SelectionChanged" Width="336"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
