<Window x:Class="GestionDentreprise.GererLesTaches"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionDentreprise"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="Gérer les tâches"
        Height="800" Width="1400"
        Icon="/images/icone-gestion.ico"
        Style="{StaticResource MaterialDesignWindow}">

    <DockPanel Background="{DynamicResource MaterialDesignPaper}">
        <Grid DockPanel.Dock="Top" Height="70" Background="{DynamicResource PrimaryHueLightBrush}">
            <TextBlock VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"
                       Text="Gestion des tâches"/>
        </Grid>

        <Grid Margin="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Margin="10" Padding="10"
                                 materialDesign:ElevationAssist.Elevation="Dp2"
                                 Background="{DynamicResource MaterialDesignPaper}" BorderBrush="#FF421E7B">
                <StackPanel>
                    <TextBlock Text="👤 Employés" 
                               FontSize="22" FontWeight="Bold" 
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                    <ListView x:Name="EmployeList"
                              Height="500"
                              BorderThickness="0"
                              Background="Transparent"
                              materialDesign:ColorZoneAssist.Mode="PrimaryLight" BorderBrush="#FF421E7B">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Margin="5">
                                    <TextBlock Text="{Binding Nom}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Poste}" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="1" Margin="10" Padding="10"
                                 materialDesign:ElevationAssist.Elevation="Dp2"
                                 Background="{DynamicResource MaterialDesignPaper}">
                <StackPanel>
                    <TextBlock Text="🗂️ Tâches"
                               FontSize="22" FontWeight="Bold" 
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                    <ListView x:Name="TacheList"
                              Height="500"
                              BorderThickness="0"
                              Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Margin="5">
                                    <TextBlock Text="{Binding Titre}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="12" Foreground="Gray" 
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2" Margin="10" Padding="20"
                                 materialDesign:ElevationAssist.Elevation="Dp3"
                                 Background="{DynamicResource MaterialDesignPaper}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button x:Name="BtnCreerTache"
                            Content="Créer une tâche"
                            Width="200" Height="50"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#FF421E7B"
                            Foreground="White"
                            Click="BtnCreerTache_Click"
                            Margin="0,0,0,20"/>

                    <Button x:Name="BtnAttribuerTache"
                            Content="Attribuer une tâche"
                            Width="200" Height="50"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#FF421E7B"
                            Foreground="#FFFAFAFA"
                            Click="BtnAttribuerTache_Click"
                             Margin="0,0,0,20"/>
                    <Button x:Name="BtnTerminé"
          Content="Terminé"
          Width="200" Height="50"
          Style="{StaticResource MaterialDesignRaisedButton}"
          Background="#FF421E7B"
          Foreground="#FFFAFAFA"
          Click="BtnAttribuerTache_Click"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </DockPanel>
</Window>
