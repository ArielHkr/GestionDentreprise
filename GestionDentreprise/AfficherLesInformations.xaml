<Window x:Class="GestionDentreprise.AfficherLesInformations"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Profil Utilisateur" Height="400" Width="400"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid Margin="20">
        <materialDesign:Card Padding="16">
            <StackPanel>
                <TextBlock Text="Informations personnelles" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,6">
                    <TextBlock Text="Nom:" Width="120"/>
                    <TextBox Width="200" x:Name="TextBoxNom" Cursor="Hand"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6">
                    <TextBlock Text="Prénom:" Width="120"/>
                    <TextBox Width="200" x:Name="TextBoxPrenom"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6">
                    <TextBlock Text="Email:" Width="120"/>
                    <TextBox Width="200" x:Name="TextBoxEmail"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6">
                    <TextBlock Text="Date d'embauche:" Width="120"/>
                    <TextBox Width="200" x:Name="TextBoxDateEmbauche" IsReadOnly="True"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Modifier" Click="BtnModifier_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,10,0"/>
                    <Button Content="Fermer" Click="BtnFermer_Click" 
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
