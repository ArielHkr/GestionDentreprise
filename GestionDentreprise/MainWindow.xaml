<Window x:Class="GestionDentreprise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionDentreprise"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Icon="/images/icone-gestion.ico"
        mc:Ignorable="d"
        WindowState="Maximized"

        Title="Connexion" Height="800" Width="1500"
        Style="{StaticResource MaterialDesignWindow}"
       
        WindowStartupLocation="CenterScreen">
       
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="389*"/>
            <ColumnDefinition Width="361*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" >
            <Image Source="pack://application:,,,/images/image-connexion.jpg"
       Stretch="Uniform"
       VerticalAlignment="Center"
       HorizontalAlignment="Center" Height="1033"/>

        </Border>
        <Grid Grid.Column="1" Margin="30,30,30,30" Cursor="Hand">
            <Grid.RowDefinitions>
                <RowDefinition Height="54*"/>
                <RowDefinition Height="Auto" MinHeight="123.037"/>
                <RowDefinition Height="Auto" MinHeight="90"/>
                <RowDefinition Height="457*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Bienvenue"
                       FontSize="26" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20" Width="128"/>

            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="206,10,206,9" Grid.RowSpan="2">
                <materialDesign:PackIcon Kind="Account" Height="69" Width="257" />
                <TextBlock Text="Email:" Margin="-3,-7,0,0" Width="248"/>
                <TextBox x:Name="txtUser"  MaxLength="50" materialDesign:HintAssist.Hint="Entrez votre nom" Width="250" BorderThickness="0,0,0,1" Margin="-3,0,0,0" />
            </StackPanel>

            <!-- Champ mot de passe -->
            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,8,0,0">
                <TextBlock Text="Mot de passe:" Width="250"/>
                <PasswordBox
    x:Name="txtPassword"
    Width="250"
    MaxLength="15"               
    Margin="0,10,0,0"
    materialDesign:HintAssist.Hint="Mot de passe" Height="26"/>
               

            </StackPanel>

            <!-- Boutons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,105,0,244" Width="120">
                <Button x:Name="btnLogin" Content="Se connecter"
                        Width="120" Height="35"
                        Click="btnLogin_Click" Margin="0,-82,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>

</Window>
